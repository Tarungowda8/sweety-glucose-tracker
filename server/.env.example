# Copy to server/.env and adjust. Never commit the real .env file.

# Port the API listens on
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://sweety:sweety_password@localhost:5432/sweety

# Long random string used to sign login tokens, e.g. run: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin of the React app (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Time zone used to decide what "today" is when checking for future dates
TZ=Asia/Kolkata
